<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Grupos de acceso -->
        <record id="group_hr_pricing_user" model="res.groups">
            <field name="name">Happy Roots: Usuario de Pricing</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Puede ver precios y usar calculadoras. No puede cambiar supuestos.</field>
        </record>

        <record id="group_hr_pricing_manager" model="res.groups">
            <field name="name">Happy Roots: Gerente de Pricing</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_pricing_user'))]"/>
            <field name="comment">Puede modificar supuestos globales, condimentos y bases de producto.</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
