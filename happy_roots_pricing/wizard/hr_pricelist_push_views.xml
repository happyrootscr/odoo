<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_pricelist_push_form" model="ir.ui.view">
        <field name="name">hr.pricelist.push.wizard.form</field>
        <field name="model">hr.pricelist.push.wizard</field>
        <field name="arch" type="xml">
            <form string="↗ Sincronizar precios con Odoo Pricelists">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Sincronización de precios</strong> — Transfiere los precios calculados por el
                        motor de pricing Happy Roots a las listas de precios nativas de Odoo.
                        Solo funciona para combos que tengan un <strong>Producto Odoo</strong> vinculado.
                    </div>
                    <group string="Combos a sincronizar">
                        <field name="combo_ids" widget="many2many_tags"
                               domain="[('state', '=', 'active'), ('product_id', '!=', False)]"/>
                    </group>
                    <group string="Listas de precios destino">
                        <group string="Canal 1 — Wholesale directo">
                            <field name="sync_direct" widget="boolean_toggle"/>
                            <field name="pricelist_direct_id"
                                   attrs="{'required': [('sync_direct', '=', True)]}"/>
                        </group>
                        <group string="Canal 2 — Distribuidor UNFI/KeHE">
                            <field name="sync_distributor" widget="boolean_toggle"/>
                            <field name="pricelist_distributor_id"
                                   attrs="{'required': [('sync_distributor', '=', True)]}"/>
                        </group>
                        <group string="Canal 3 — DTC Shopify/Amazon">
                            <field name="sync_dtc" widget="boolean_toggle"/>
                            <field name="pricelist_dtc_id"
                                   attrs="{'required': [('sync_dtc', '=', True)]}"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('result_summary', '=', False)]}">
                        <field name="result_summary" readonly="1" widget="text"/>
                    </group>
                    <footer>
                        <button name="action_create_pricelists" type="object"
                                string="Crear listas HR (si no existen)"
                                class="btn-secondary"/>
                        <button name="action_push_prices" type="object"
                                string="↗ Sincronizar precios"
                                class="btn-primary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_pricelist_push" model="ir.actions.act_window">
        <field name="name">Sincronizar con Pricelists Odoo</field>
        <field name="res_model">hr.pricelist.push.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
