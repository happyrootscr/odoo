<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_seasoning_form" model="ir.ui.view">
        <field name="name">hr.seasoning.form</field>
        <field name="model">hr.seasoning</field>
        <field name="arch" type="xml">
            <form string="Condimento">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_combos" type="object"
                                class="oe_stat_button" icon="fa-tags">
                            <field name="combo_count" widget="statinfo" string="Combos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Precio y especificaciones">
                            <field name="code"/>
                            <field name="price_per_kg_usd"/>
                            <field name="is_confirmed" widget="boolean_toggle"/>
                            <field name="presentation"/>
                        </group>
                        <group string="Cotización">
                            <field name="quotation_ref"/>
                            <field name="quotation_date"/>
                            <field name="valid_until"/>
                            <field name="supplier_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_seasoning_list" model="ir.ui.view">
        <field name="name">hr.seasoning.list</field>
        <field name="model">hr.seasoning</field>
        <field name="arch" type="xml">
            <list string="Condimentos Maluquer"
                  decoration-warning="not is_confirmed">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="price_per_kg_usd" string="USD/kg"/>
                <field name="is_confirmed" string="Confirmado" widget="boolean"/>
                <field name="quotation_ref" optional="show"/>
                <field name="valid_until" optional="show"/>
                <field name="combo_count" string="# Combos"/>
            </list>
        </field>
    </record>

    <record id="action_hr_seasoning" model="ir.actions.act_window">
        <field name="name">Condimentos Maluquer</field>
        <field name="res_model">hr.seasoning</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
