<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_product_base_form" model="ir.ui.view">
        <field name="name">hr.product.base.form</field>
        <field name="model">hr.product.base</field>
        <field name="arch" type="xml">
            <form string="SKU Base">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_combos" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="combo_count" widget="statinfo" string="Sabores"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Formato físico">
                            <field name="format_weight_g"/>
                            <field name="format_weight_oz" readonly="1" digits="[10,4]"/>
                            <field name="box_type"/>
                            <field name="product_template_id"/>
                        </group>
                        <group string="Maquila ADM Don Mariano">
                            <field name="maquila_cost_crc_per_kg"/>
                            <field name="maquila_confirmed" widget="boolean_toggle"/>
                            <field name="maquila_quotation_date"/>
                            <field name="maquila_supplier_id"/>
                            <field name="maquila_notes"/>
                        </group>
                    </group>
                    <group>
                        <group string="Bolsas Indupark">
                            <field name="bag_cost_usd" digits="[10,6]"/>
                            <field name="bag_dimensions"/>
                            <field name="bag_supplier_id"/>
                        </group>
                        <group string="Cajas y contenedor">
                            <field name="box_cost_usd"/>
                            <field name="bags_per_box"/>
                            <field name="bags_per_container"/>
                            <field name="boxes_per_container" readonly="1"/>
                            <field name="kg_neto_per_container" readonly="1" digits="[10,2]"/>
                        </group>
                    </group>
                    <separator string="Precios Wholesale y MSRP (nivel SKU — igual para todos los sabores)"/>
                    <group>
                        <group string="Margen HR">
                            <field name="margin_hr_override" widget="boolean_toggle"/>
                            <field name="margin_hr_custom_pct" widget="percentage"
                                   attrs="{'invisible': [('margin_hr_override', '=', False)],
                                           'required': [('margin_hr_override', '=', True)]}"/>
                            <field name="min_ddp_usd" readonly="1" digits="[10,6]"/>
                        </group>
                        <group string="Precios calculados (USD/bolsa)">
                            <field name="price_wholesale_usd" readonly="1" digits="[10,6]"
                                   class="hr_price_wholesale"
                                   style="font-size:1.2em; font-weight:bold; color:#8e44ad;"/>
                            <field name="price_wholesale_distributor_usd" readonly="1"
                                   digits="[10,6]"/>
                            <field name="price_msrp_usd" readonly="1" digits="[10,6]"
                                   class="hr_price_final"
                                   style="font-size:1.3em; font-weight:bold; color:#c0392b;"/>
                        </group>
                    </group>
                    <separator string="Estrategia"/>
                    <group>
                        <field name="channel_recommendation"/>
                    </group>
                    <separator string="Combos / Sabores vinculados"/>
                    <field name="combo_ids" readonly="1">
                        <list>
                            <field name="internal_code"/>
                            <field name="seasoning_id"/>
                            <field name="dosification_kg_per_bag" digits="[10,5]"/>
                            <field name="price_exw" digits="[10,6]"/>
                            <field name="price_ddp" digits="[10,6]"/>
                            <field name="margin_pct_direct" widget="percentage" digits="[6,2]"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_product_base_list" model="ir.ui.view">
        <field name="name">hr.product.base.list</field>
        <field name="model">hr.product.base</field>
        <field name="arch" type="xml">
            <list string="SKUs Base">
                <field name="name"/>
                <field name="format_weight_g"/>
                <field name="box_type"/>
                <field name="maquila_cost_crc_per_kg" string="₡/kg maquila"/>
                <field name="bag_cost_usd" string="USD bolsa" digits="[10,6]"/>
                <field name="bags_per_container" string="Bolsas/cont."/>
                <field name="min_ddp_usd" string="DDP mín." digits="[10,6]"/>
                <field name="price_wholesale_usd" string="Wholesale" digits="[10,6]"/>
                <field name="price_msrp_usd" string="MSRP" digits="[10,6]"/>
                <field name="combo_count" string="# Sabores"/>
            </list>
        </field>
    </record>

    <record id="action_hr_product_base" model="ir.actions.act_window">
        <field name="name">SKUs Base</field>
        <field name="res_model">hr.product.base</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
