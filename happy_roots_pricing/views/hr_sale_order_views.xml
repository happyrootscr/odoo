<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extiende el formulario de cotización/SO con campo destino HR -->
    <record id="view_sale_order_hr_form" model="ir.ui.view">
        <field name="name">sale.order.hr.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Agregar destino HR junto al incoterm -->
            <xpath expr="//field[@name='incoterm']" position="after">
                <field name="hr_destination_id"
                       options="{'no_create': True}"
                       placeholder="Seleccionar destino…"/>
            </xpath>
        </field>
    </record>
</odoo>
