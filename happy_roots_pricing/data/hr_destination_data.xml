<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- USA — Miami (DDP) -->
        <record id="dest_usa_miami" model="hr.destination">
            <field name="sequence">10</field>
            <field name="name">USA — Miami (DDP)</field>
            <field name="country_id" ref="base.us"/>
            <field name="port_arrival">Miami, FL</field>
            <field name="freight_per_container_usd">3500.0</field>
            <field name="insurance_pct">0.5</field>
            <field name="tariff_pct">0.0</field>
            <field name="customs_fixed_per_container">850.0</field>
            <field name="last_mile_per_bag_usd">0.05</field>
            <field name="has_direct_channel">True</field>
            <field name="has_distributor_channel">True</field>
            <field name="has_dtc_channel">True</field>
            <field name="has_amazon_channel">True</field>
            <field name="amazon_fee_pct">15.0</field>
            <field name="amazon_fba_per_unit_usd">0.0</field>
        </record>

        <!-- USA — Los Angeles -->
        <record id="dest_usa_la" model="hr.destination">
            <field name="sequence">20</field>
            <field name="name">USA — Los Ángeles (DDP)</field>
            <field name="country_id" ref="base.us"/>
